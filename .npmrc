# Fail fast if the Node version in package.json "engines" isn't satisfied.
# This is the enforcement mechanism for Node 24 — .node-version / .tool-versions
# are only hints that a version manager may or may not read (Volta ignores both).
engine-strict=true

# Never run dependency lifecycle scripts (preinstall/install/postinstall) on install.
# npm 12+ does this by default; setting it explicitly keeps the guarantee on npm 11
# and makes the policy visible in-repo. Project scripts via `npm run` are unaffected.
ignore-scripts=true

# Keep installs quiet and reproducible.
fund=false
